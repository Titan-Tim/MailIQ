generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  BASIC
  BRANDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  logoUrl       String?
  brandColor    String?      @default("#7c3aed")
  plan          TenantPlan   @default(BASIC)
  status        TenantStatus @default(ACTIVE)
  suspendedAt   DateTime?
  suspendReason String?

  ingestKey     String?      @unique   // scan-folder watcher agent auth
  licenceExpiresAt DateTime?            // annual licence; access blocked once past
  enabledModules String[]   @default(["inbound", "outbound"])  // licensed modules; gates in/outbound

  addressZoneX      Float @default(20)
  addressZoneY      Float @default(49)
  addressZoneWidth  Float @default(85)
  addressZoneHeight Float @default(35)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  recipients Recipient[]
  inserts    Insert[]
  rules      DispatchRule[]
  dispatches Dispatch[]
  batches    PrintBatch[]
  campaigns  Campaign[]

  // Inbound module (Digital Mailroom) — additive, does not affect outbound
  mailboxes    Mailbox[]
  inboundRules InboundRoutingRule[]
  inboundItems InboundItem[]
  exportRules  InboundExportRule[]
  teams        Team[]
}

enum UserRole {
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  email              String   @unique
  passwordHash       String
  name               String?
  role               UserRole @default(OPERATOR)
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  isPlatformAdmin    Boolean  @default(false)  // provider-level: manage all tenancies
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teamMemberships TeamMember[]
  ownedMailboxes  Mailbox[]   @relation("PersonalMailbox")
}

enum DeliveryMethod {
  DIGITAL
  POST
  AUTO
}

model Recipient {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  accountNumber String?
  reference     String?
  externalId    String?
  title         String?
  firstName     String?
  lastName      String
  companyName   String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  county        String?
  postcode      String?
  country       String         @default("GB")
  email         String?
  deliveryMethod DeliveryMethod @default(AUTO)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  dispatches Dispatch[]

  @@index([tenantId])
  @@index([tenantId, accountNumber])
  @@index([tenantId, externalId])
}

model Insert {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  description   String?
  category      String?
  fileKey       String
  fileName      String
  fileSizeBytes Int
  pageCount     Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleInserts     DispatchRuleInsert[]
  dispatchInserts DispatchInsert[]
}

model DispatchRule {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  name             String
  documentType     String?
  priority         Int             @default(0)
  deliveryOverride DeliveryMethod?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  inserts DispatchRuleInsert[]
}

model DispatchRuleInsert {
  id       String       @id @default(cuid())
  ruleId   String
  rule     DispatchRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  insertId String
  insert   Insert       @relation(fields: [insertId], references: [id])
  order    Int          @default(0)
}

enum DispatchStatus {
  PENDING
  COMPOSING
  READY
  QUEUED
  SENT
  RETURNED
  FAILED
}

model Dispatch {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  recipientId      String?
  recipient        Recipient?     @relation(fields: [recipientId], references: [id])
  campaignId       String?
  campaign         Campaign?      @relation(fields: [campaignId], references: [id])
  originalFileKey  String
  originalFileName String
  fileSizeBytes    Int
  pageCount        Int            @default(1)
  composedFileKey  String?
  documentType     String?
  reference        String?
  notes            String?
  barcodeCode      String         @unique
  addressOverride  Json?
  status           DispatchStatus @default(PENDING)
  deliveryMethod   DeliveryMethod?
  errorMessage     String?
  returnedAt       DateTime?      // closed loop: when its QR came back through inbound
  returnedVia      String?        // SCAN | PORTAL
  uploadedAt       DateTime       @default(now())
  composedAt       DateTime?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  inserts        DispatchInsert[]
  digitalSend    DigitalSend?
  printBatchItem PrintBatchItem?
  returnMail     ReturnMail?
  portalUploads  PortalUpload[]

  @@index([tenantId, status])
  @@index([barcodeCode])
  @@index([campaignId])
}

// A mailshot: one base document sent to many recipients, each personalised
// (address + reference + unique QR) and routed by the recipient's preference.
model Campaign {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  name         String
  baseFileKey  String
  baseFileName String
  subject      String?        // email subject for digital recipients
  addQr        Boolean        @default(true) // stamp a unique return QR on each copy
  status       CampaignStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dispatches Dispatch[]

  @@index([tenantId])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

// A file a recipient uploaded back through their portal link (closed loop, digital).
model PortalUpload {
  id            String   @id @default(cuid())
  dispatchId    String
  dispatch      Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fileKey       String
  fileName      String
  fileSizeBytes Int      @default(0)
  uploadedAt    DateTime @default(now())

  @@index([dispatchId])
}

model DispatchInsert {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  insertId   String
  insert     Insert   @relation(fields: [insertId], references: [id])
  order      Int      @default(0)
  source     String   @default("manual")
}

model DigitalSend {
  id              String    @id @default(cuid())
  dispatchId      String    @unique
  dispatch        Dispatch  @relation(fields: [dispatchId], references: [id])
  toEmail         String
  subject         String
  trackingToken   String    @unique @default(cuid())
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  openCount       Int       @default(0)
  firstDownloadAt DateTime?
  downloadCount   Int       @default(0)
  createdAt       DateTime  @default(now())
}

enum BatchStatus {
  OPEN
  READY
  PRINTED
  POSTED
}

model PrintBatch {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  name          String
  mergedFileKey String?
  status        BatchStatus @default(OPEN)
  itemCount     Int         @default(0)
  totalPages    Int         @default(0)
  createdAt     DateTime    @default(now())
  printedAt     DateTime?
  postedAt      DateTime?

  items PrintBatchItem[]
}

model PrintBatchItem {
  id         String     @id @default(cuid())
  batchId    String
  batch      PrintBatch @relation(fields: [batchId], references: [id])
  dispatchId String     @unique
  dispatch   Dispatch   @relation(fields: [dispatchId], references: [id])
  pageCount  Int        @default(1)
  order      Int        @default(0)
  addedAt    DateTime   @default(now())
}

model ReturnMail {
  id           String    @id @default(cuid())
  dispatchId   String    @unique
  dispatch     Dispatch  @relation(fields: [dispatchId], references: [id])
  scannedCode  String
  returnReason String?
  notes        String?
  scannedAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
}

// ════════════════════════════════════════════════════════════════════════════
//  INBOUND MODULE — Digital Mailroom
//  Scanned physical post → OCR → classify → route to an internal Mailbox.
//  Entirely additive: shares Tenant/User but never touches the outbound models.
// ════════════════════════════════════════════════════════════════════════════

enum InboundStatus {
  RECEIVED    // uploaded/scanned, awaiting processing
  PROCESSING  // OCR + classification running
  CLASSIFIED  // text extracted, type + addressee known, not yet delivered
  TRIAGE      // low confidence or no match — needs a human decision
  DELIVERED   // routed and emailed to a Mailbox
  REJECTED    // junk / discarded
}

/// An internal routing destination for inbound post (a person, department, or
/// shared inbox). Separate from the outbound Recipient (external customers).
model Mailbox {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String                 // e.g. "Accounts", "Jane Smith", "HR"
  department String?
  email      String                 // destination inbox address
  keywords   String?                // comma-separated aliases used for matching
  isDefault  Boolean  @default(false) // catch-all fallback mailbox
  isActive   Boolean  @default(true)

  // Ownership — TEAM-owned (shared), PERSONAL (one user, private), or GENERAL
  // (both null; admin-managed, e.g. the catch-all). At most one of these is set.
  teamId      String?
  team        Team?   @relation(fields: [teamId], references: [id])
  ownerUserId String?
  ownerUser   User?   @relation("PersonalMailbox", fields: [ownerUserId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items InboundItem[]
  rules InboundRoutingRule[]

  @@index([tenantId])
  @@index([teamId])
  @@index([ownerUserId])
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TeamMember[]
  mailboxes Mailbox[]

  @@index([tenantId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

/// A rule that routes inbound post to a Mailbox based on document type and/or
/// keyword match. Higher priority wins.
model InboundRoutingRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  priority        Int      @default(0)      // higher wins
  matchType       String   @default("ANY")  // ANY | ALL of the conditions below
  documentType    String?                   // match classified doc type
  keyword         String?                   // match addressee/text contains keyword
  targetMailboxId String?
  targetMailbox   Mailbox? @relation(fields: [targetMailboxId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

/// A per-client export/filing rule: identify a reference by FORMAT MASK in the
/// document text, name the file, and export it to a downstream watch folder.
model InboundExportRule {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  priority         Int      @default(0)     // higher wins
  matchDocumentType String?                 // only apply to this classified type
  matchKeyword     String?                  // only apply when text contains this (e.g. client name)
  format           String                   // mask: # digit, #+ one-or-more digits, else literal
  filenameTemplate String   @default("{ref}.pdf")
  exportTarget     String   @default("default") // agent maps this to a local watch folder
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

/// A single piece of inbound post moving through the pipeline.
model InboundItem {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  fileKey       String?              // stored scan (PDF/image)
  fileName      String
  fileSizeBytes Int     @default(0)
  pageCount     Int     @default(1)
  source        String  @default("upload") // upload | scan-email | agent

  ocrText       String?              // extracted text
  extractedName String?              // addressee/recipient extracted
  documentType  String?              // classified type (invoice, legal, hr…)
  confidence    Float   @default(0)  // 0..1 routing confidence

  status           InboundStatus @default(RECEIVED)
  matchedMailboxId String?
  matchedMailbox   Mailbox?      @relation(fields: [matchedMailboxId], references: [id])
  matchedRuleId    String?
  routingReason    String?            // audit: why it routed where it did

  // Export/filing layer — reference extracted + filename for a downstream watch folder
  exportRef      String?
  exportFilename String?
  exportTarget   String?
  deliveredEmail   String?
  deliveredAt      DateTime?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events InboundEvent[]

  @@index([tenantId, status])
}

/// Immutable audit trail for an inbound item (every decision is logged).
model InboundEvent {
  id        String      @id @default(cuid())
  itemId    String
  item      InboundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String      // RECEIVED | OCR | CLASSIFIED | ROUTED | REROUTED | DELIVERED | REJECTED
  detail    String?
  actor     String?     // "system" or a user's email
  createdAt DateTime    @default(now())

  @@index([itemId])
}

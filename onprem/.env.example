# ── Mail-IQ on-prem configuration ──────────────────────────────────────────────
# Copy to .env and fill in.  cp .env.example .env

# Public hostname + URL the app is reached on (same value, host vs full URL).
PUBLIC_HOST=mailiq.yourfirm.local
PUBLIC_URL=https://mailiq.yourfirm.local
SUPPORT_EMAIL=support@sol-iq.co.uk

# Database (Postgres runs in a container; pick a strong password).
POSTGRES_USER=mailiq
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=mailiq

# Auth secrets — generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_64_hex_chars

# Signed licence (from the provider). Put the file at ./licence/mailiq.licence.
# Leave it absent to run UNLICENSED in database mode for initial testing;
# add it to enforce module entitlements + expiry. Optionally point elsewhere:
# LICENCE_DIR=./licence

# First-run admin — creates the initial login the first time the DB is empty.
BOOTSTRAP_ORG=Your Firm Name
BOOTSTRAP_ADMIN_EMAIL=admin@yourfirm.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_8_chars
BOOTSTRAP_ADMIN_NAME=IT Administrator

# Local OCR for scanned/image-only documents. 'tesseract' (bundled in the image)
# works fully offline; set to 'stub' to disable OCR and rely on text-layer only.
OCR_DRIVER=tesseract
TESSERACT_LANG=eng

# Email (optional). Point at the customer's mail server; leave SMTP_HOST empty
# to disable outgoing email (password resets / invites will be skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_NAME=Mail-IQ
FROM_EMAIL=noreply@yourfirm.local

# SMS (optional — Twilio). Texts recipients their portal link. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # a Twilio number "+44…" or an Alphanumeric Sender ID
# TWILIO_MESSAGING_SERVICE_SID=   # alternative to TWILIO_FROM (starts "MG…")
